) {

  // 1. Classify the task

  const classification = classifyTask(
    request.task,
    Boolean(request.imageUrl)
  );

  // 2. Load authorized project context

  const context = await loadContext(request);

  // 3. Resolve policy conflicts

  const conflicts = resolveConflicts(
    request.constraints,
    {}
  );

  const blockingConflicts =
    conflicts.filter(
      item => item.resolution === "block"
    );

  if (blockingConflicts.length) {
    throw new Error(
      "Request violates application policy"
    );
  }

  const questions =
    conflicts.filter(
      item => item.resolution === "ask"
    );

  if (questions.length) {
    return {
      status: "needs_clarification",
      questions
    };
  }

  // 4. Compile instructions

  const compiled = compilePrompt(
    request,
    context
  );

  // 5. Select the appropriate model

  const route = selectModel(
    classification.intent
  );

  // 6. Execute the operation

  if (route.modelType === "vision") {
    return await visionProvider.analyze({
      imageUrl: request.imageUrl!,
      prompt: compiled.user
    });
  }

  if (
    route.modelType === "image_generation" ||
    route.modelType === "image_editing"
  ) {
    return await imageProvider.generateImage({
      prompt: compiled.system +
        "\n" + compiled.user,

      imageUrl: request.imageUrl,

      quality: request.output.quality
    });
  }

  throw new Error(
    "No compatible provider configured"
  );
}
